Plugins>LeidenUniv>Tools, "HeatMap", LeidenUniv.Tools.HeatMap_("")
Plugins>LeidenUniv>Tools, "Kymogram", LeidenUniv.Tools.Kymogramsv2_("")
Plugins>LeidenUniv>Tools, "Line Analysis", LeidenUniv.Tools.Line_Analysis("")
Plugins>LeidenUniv>Tools, "Local Curvature", LeidenUniv.Tools.Local_Curvature("")
